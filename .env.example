# ============================================================================
# Stellaris Environment Variables
# Copy to .env for local development defaults.
# Copy to .env.local for secret overrides.
# Both .env and .env.local are gitignored — never commit them.
# ============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — JWT session signing secret (min 32 chars for HS256)
# In development, a built-in fallback is used if not set.
# In production, this MUST be set to a strong random secret.
AUTH_SESSION_SECRET=

# Private Registry Mode
# When "true" (default), ALL routes require authentication.
# Only login/signup and infrastructure endpoints (health, .well-known, API) are public.
# When "false", the homepage and other non-admin routes are publicly accessible.
PRIVATE_REGISTRY=true

# Artifact Authentication Mode (API artifact downloads)
# Controls whether artifact-serving routes (tarballs, provider zips, SHA256SUMS)
# require Bearer token authentication.
# This is INDEPENDENT of PRIVATE_REGISTRY (which controls web UI session auth).
#
# Options: relaxed | strict  (default: relaxed)
#
# "relaxed" — Artifacts served without auth. Compatible with vanilla tofu/terraform.
#             Metadata/discovery endpoints still require Bearer auth.
#             Anyone who discovers an artifact URL can download it.
#
# "strict"  — ALL API routes require Bearer auth, including artifact downloads.
#             Requires stellaris-auth proxy (or equivalent) on the client side,
#             because Terraform/OpenTofu does NOT forward Bearer tokens when
#             following X-Terraform-Get / download redirect URLs.
#             See: https://github.com/hyvmind-io/stellaris-auth
#
# Configuration matrix:
#   PRIVATE_REGISTRY=true  + PRIVATE_REGISTRY_MODE=relaxed  → Web: login, API: partial auth (default)
#   PRIVATE_REGISTRY=true  + PRIVATE_REGISTRY_MODE=strict   → Web: login, API: full auth (max security)
#   PRIVATE_REGISTRY=false + PRIVATE_REGISTRY_MODE=relaxed  → Web: public, API: partial auth
#   PRIVATE_REGISTRY=false + PRIVATE_REGISTRY_MODE=strict   → Web: public, API: full auth
PRIVATE_REGISTRY_MODE=relaxed

# Storage Backend
# Options: local | r2 | s3 | s3-compatible  (default: r2)
# "local"          → Node.js filesystem (.storage/). Use with pnpm dev.
# "r2"             → Cloudflare R2 (default for preview + production).
# "s3"             → AWS S3.
# "s3-compatible"  → S3-compatible services (MinIO, Tigris, Backblaze B2, etc.).
STORAGE_BACKEND=local

# ============================================================================
# HTTPS Local Development (optional — for testing PRIVATE_REGISTRY mode)
# ============================================================================

# Set NEXT_PUBLIC_APP_URL to https when using dev:https
# NEXT_PUBLIC_APP_URL=https://localhost:3000

# Certificate paths (generated by: pnpm dev:generate-certs)
# These are used automatically by the dev:https script via CLI flags.
# HTTPS_KEY_PATH=.certificates/localhost-key.pem
# HTTPS_CERT_PATH=.certificates/localhost.pem
# HTTPS_CA_PATH=.certificates/ca-cert.pem
#
# Terraform/OpenTofu: trust the self-signed CA with:
#   export SSL_CERT_FILE=.certificates/ca-cert.pem
# Or skip TLS entirely (dev only):
#   export TOFU_TLS_SKIP_VERIFY=1

# ============================================================================
# S3 / S3-Compatible Storage (required when STORAGE_BACKEND=s3 or s3-compatible)
# ============================================================================

# S3 bucket name
S3_BUCKET=

# AWS region (e.g., us-east-1)
S3_REGION=us-east-1

# Credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Custom endpoint URL (required for s3-compatible, optional for s3)
# Examples:
#   MinIO:      http://localhost:9000
#   Tigris:     https://fly.storage.tigris.dev
#   Backblaze:  https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=

# Use path-style URLs instead of virtual-hosted-style (required for MinIO)
# Set to "true" for MinIO and some other S3-compatible services
S3_FORCE_PATH_STYLE=false

# Cloudflare Account (for drizzle-kit remote operations)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
