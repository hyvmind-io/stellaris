# ============================================================================
# Stellaris Environment Variables
# Copy to .env for local development defaults.
# Copy to .env.local for secret overrides.
# Both .env and .env.local are gitignored — never commit them.
# ============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — JWT session signing secret (min 32 chars for HS256)
# In development, a built-in fallback is used if not set.
# In production, this MUST be set to a strong random secret.
AUTH_SESSION_SECRET=

# Storage Backend
# Options: local | r2 | s3 | s3-compatible  (default: r2)
# "local"          → Node.js filesystem (.storage/). Use with pnpm dev.
# "r2"             → Cloudflare R2 (default for preview + production).
# "s3"             → AWS S3.
# "s3-compatible"  → S3-compatible services (MinIO, Tigris, Backblaze B2, etc.).
STORAGE_BACKEND=local

# ============================================================================
# S3 / S3-Compatible Storage (required when STORAGE_BACKEND=s3 or s3-compatible)
# ============================================================================

# S3 bucket name
S3_BUCKET=

# AWS region (e.g., us-east-1)
S3_REGION=us-east-1

# Credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Custom endpoint URL (required for s3-compatible, optional for s3)
# Examples:
#   MinIO:      http://localhost:9000
#   Tigris:     https://fly.storage.tigris.dev
#   Backblaze:  https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=

# Use path-style URLs instead of virtual-hosted-style (required for MinIO)
# Set to "true" for MinIO and some other S3-compatible services
S3_FORCE_PATH_STYLE=false

# Cloudflare Account (for drizzle-kit remote operations)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
