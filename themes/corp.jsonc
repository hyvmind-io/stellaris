{
  // Example theme — Corporate blue. Demonstrates the JSONC format (comments and
  // trailing commas allowed). Identical shape to the YAML format. Optional token
  // groups omitted here inherit the built-in Dracula/Alucard default values.
  "name": "corp",
  "label": "Corporate",
  "light": {
    "background": "#ffffff",
    "foreground": "210 20% 12%", // hex or HSL both accepted
    "card": "#ffffff",
    "card-foreground": "210 20% 12%",
    "popover": "#ffffff",
    "popover-foreground": "210 20% 12%",
    "primary": "#0A66C2",
    "primary-foreground": "#ffffff",
    "secondary": "210 16% 93%",
    "secondary-foreground": "210 20% 12%",
    "muted": "210 16% 95%",
    "muted-foreground": "210 12% 40%",
    "accent": "#0A66C2",
    "accent-foreground": "#ffffff",
    "destructive": "#C0392B",
    "destructive-foreground": "#ffffff",
    "border": "210 16% 88%",
    "input": "210 16% 88%",
    "ring": "#0A66C2",
    "radius": "0.375rem",
  },
  "dark": {
    "background": "210 30% 8%",
    "foreground": "#f5f7fa",
    "card": "210 28% 11%",
    "card-foreground": "#f5f7fa",
    "popover": "210 28% 11%",
    "popover-foreground": "#f5f7fa",
    "primary": "#4C9AFF",
    "primary-foreground": "210 30% 8%",
    "secondary": "210 20% 18%",
    "secondary-foreground": "#f5f7fa",
    "muted": "210 20% 18%",
    "muted-foreground": "210 12% 60%",
    "accent": "#4C9AFF",
    "accent-foreground": "210 30% 8%",
    "destructive": "#FF6B6B",
    "destructive-foreground": "210 30% 8%",
    "border": "210 20% 20%",
    "input": "210 20% 20%",
    "ring": "#4C9AFF",
    "radius": "0.375rem",
  },
}
