{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stellaris",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stellaris"
    }
  ],
  // D1 Database — Terraform registry metadata
  // Create with: wrangler d1 create stellaris-db
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stellaris-db",
      "database_id": "placeholder-update-after-creation",
      // Wrangler migration tracking — enables `wrangler d1 migrations apply`
      // to apply only pending migrations and record applied ones in D1_MIGRATIONS.
      "migrations_dir": "drizzle"
    }
  ],
  // R2 Bucket — Module/provider artifact storage
  // Create with: wrangler r2 bucket create stellaris-modules
  "r2_buckets": [
    {
      "binding": "MODULES_STORAGE",
      "bucket_name": "stellaris-modules"
    }
  ],
  // Per-IP rate limits (Workers Rate Limiting, available on Free).
  // API_RATE_LIMITER guards /v1 before the D1 key lookup; AUTH_RATE_LIMITER guards login/signup.
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NODE_ENV": "production",
    // "true" on Workers Free: artifacts redirect to R2 (see docs/configuration.md)
    "CLOUDFLARE_WORKERS_FREE_TIER": "false"
  }
}
